# ========== Server ==========
node_id = node_1
listen_port = 9002
upload_port = 9003
worker_num = 4
upload_worker_num = 4
jwt_secret_file = ./secret/jwt_secret.key

# ========== ThreadPool ==========
thread_pool_size = 8

# ========== Redis ==========
redis_host = redis
redis_port = 6379
redis_password = <你的Redis密码>
redis_pool_size = 4

# ========== MySQL ==========
mysql_host = mysql
mysql_port = 3306
mysql_username = ChatFreely
mysql_password = <你的MySQL_业务密码>
mysql_dbname = ChatFreely
mysql_min_connection = 3
mysql_max_connection = 10
mysql_min_alive_minutes = 60
mysql_max_alive_minutes = 240
mysql_min_free_minutes = 20
mysql_max_free_minutes = 40

# ========== MinIO ==========
minio_endpoint = http://minio:9000
minio_access_key = <你的MinIO账号>
minio_secret_key = <你的MinIO密码>
minio_region = us-east-1
minio_bucket = chat

# ========== Public Access ==========
public_url_prefix = https://<你的公网IP或域名>/chat/
upload_public_host = <你的公网IP或域名>

# ========== Timeouts ==========
mysql_connect_timeout = 3
redis_connect_timeout = 1000
redis_socket_timeout = 1000
http_connect_timeout = 2
http_total_timeout = 5
