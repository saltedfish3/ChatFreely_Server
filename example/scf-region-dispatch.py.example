# -*- coding: utf-8 -*-
# 腾讯云 SCF：按客户端地域返回最近接入入口
#
# 触发器：API 网关 GET /config
# 运行环境：Python 3.10
# 执行方法：index.main_handler
#
# 依赖（与 index.py 同级放置）：
#   pip install py-ip2region -t .     # 注意包名是 py-ip2region，import 名是 ip2region
#   ip2region_v4.xdb                  # 离线库，约 10.6MB
#
# 客户端调用：GET https://api.chatfreely.cloud/config
# 返回示例：{"serverHost":"gz.chatfreely.cloud","tcpPort":9443,"useHttps":true}

import os
import json
import logging

import ip2region.util as iutil
import ip2region.searcher as xdb

logger = logging.getLogger()
logger.setLevel(logging.INFO)

# ---------- 地域配置 ----------
# 地域 key -> 该地域的接入域名
REGION_MAP = {
    "guangzhou": "gz.chatfreely.cloud",
}

# 无法判断地域时的兜底
DEFAULT_REGION = "guangzhou"

# 省份 -> 地域
# 目前只有广州一个节点，保留一条作示例；其他省份都会回落到 DEFAULT_REGION。
# 新增上海节点时，按下面的写法补充即可，无需改动其他代码：
#   REGION_MAP["shanghai"] = "sh.chatfreely.cloud"
#   PROVINCE_REGION.update({
#       "上海": "shanghai", "江苏": "shanghai", "浙江": "shanghai",
#       "安徽": "shanghai", "福建": "shanghai", "江西": "shanghai",
#       "山东": "shanghai",
#   })
PROVINCE_REGION = {
    "广东": "guangzhou",
}

# ---------- 离线库 ----------
# 用 __file__ 定位，避免依赖进程工作目录
_XDB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ip2region_v4.xdb")

_searcher = None

def _get_searcher():
    """模块级缓存，实例复用时避免重复加载离线库"""
    global _searcher
    if _searcher is None:
        _searcher = xdb.new_with_file_only(iutil.IPv4, _XDB_PATH)
    return _searcher

# ---------- 工具函数 ----------
def _client_ip(event):
    """优先取 X-Forwarded-For；挂了 CDN 后 sourceIp 会是 CDN 节点 IP"""
    headers = {str(k).lower(): v for k, v in (event.get("headers") or {}).items()}
    xff = headers.get("x-forwarded-for") or ""
    if xff:
        ip = xff.split(",")[0].strip()
        if ip:
            return ip
    return (event.get("requestContext") or {}).get("sourceIp", "")

def _resolve_region(client_ip):
    """IP -> 地域，任何异常都回落到默认地域"""
    if not client_ip:
        return DEFAULT_REGION
    try:
        # py-ip2region 3.x 返回 "中国|广东省|深圳市|电信|CN"
        region_text = _get_searcher().search(client_ip)
        parts = region_text.split("|")
        province = parts[1] if len(parts) > 1 else ""
        # 包含匹配，兼容 "广东" / "广东省"
        for name, region in PROVINCE_REGION.items():
            if name in province:
                return region
    except Exception as e:
        logger.warning("ip2region failed: %s, ip=%s", e, client_ip)
    return DEFAULT_REGION

# ---------- 入口 ----------
def main_handler(event, context):
    if (event.get("httpMethod") or "GET").upper() != "GET":
        return {
            "isBase64Encoded": False,
            "statusCode": 405,
            "headers": {"Content-Type": "application/json"},
            "body": json.dumps({"error": "method not allowed"}),
        }

    client_ip = _client_ip(event)
    region = _resolve_region(client_ip)
    logger.info("client_ip=%s -> region=%s", client_ip, region)

    body = {
        "serverHost": REGION_MAP[region],
        "tcpPort": 9443,
        "useHttps": True,
    }

    return {
        "isBase64Encoded": False,
        "statusCode": 200,
        "headers": {
            "Content-Type": "application/json",
            # 返回内容随客户端 IP 变化，禁止公开缓存，否则会串地域
            "Cache-Control": "no-store",
        },
        "body": json.dumps(body, ensure_ascii=False),
    }
