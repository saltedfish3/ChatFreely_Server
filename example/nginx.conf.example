# 单机部署：upstream 里只保留一个 127.0.0.1
# 地域入口：upstream 里填该地域各节点的内网 IP
# 使用云 CLB 时不需要本文件

worker_rlimit_nofile 100000;
worker_processes auto;

events {
    worker_connections 65535;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    client_max_body_size 2g;

    # 上传 API 后端
    upstream upload_nodes {
        least_conn;
        server 127.0.0.1:9003 max_fails=3 fail_timeout=10s;
        # server 10.0.1.12:9003 max_fails=3 fail_timeout=10s;
    }

    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name <域名>;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;

        # 媒体下载与大文件直传共用此路径
        location /chat/ {
            # 单机填 127.0.0.1:9000；多节点填共享 MinIO 内网地址
            proxy_pass http://127.0.0.1:9000/chat/;
            proxy_set_header Host $host;
            proxy_set_header Range $http_range;
            proxy_set_header If-Range $http_if_range;
            proxy_buffering off;
            proxy_request_buffering off;
        }

        location /upload/ {
            proxy_pass http://upload_nodes/upload/;
            proxy_set_header Host $host;
            proxy_request_buffering off;
            proxy_read_timeout 300s;
        }

        # 客户端引导配置，静态返回
        location = /config {
            default_type application/json;
            return 200 '{"serverHost":"<域名>","tcpPort":9443,"useHttps":true}';
        }
    }
}

stream {
    upstream chat_tcp {
        least_conn;
        server 127.0.0.1:9002 max_fails=3 fail_timeout=10s;
        # server 10.0.1.12:9002 max_fails=3 fail_timeout=10s;
    }

    server {
        listen 9443 ssl;
        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:20m;

        proxy_pass chat_tcp;
        # 长连接不能提前断开
        proxy_timeout 24h;
        proxy_connect_timeout 5s;
        proxy_next_upstream on;
    }
}
