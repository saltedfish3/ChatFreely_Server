# ========== Server ==========
# 节点标识，格式 node_N（N 取 1~32），多节点部署时每台必须不同
# 内部据此推导雪花算法 workerId，保证跨节点消息 ID 不冲突
node_id = node_1

# 内部端口，保持默认，由网关（Nginx / CLB）对外转发
listen_port = 9002
upload_port = 9003

worker_num = 4
upload_worker_num = 4

# JWT 密钥，多节点必须指向同一份内容的文件
jwt_secret_file = ./secret/jwt_secret.key

# ========== ThreadPool ==========
thread_pool_size = 8

# ========== Redis ==========
redis_host = <Redis地址>
redis_port = 6379
redis_password = <Redis密码>
redis_pool_size = 4

# 云 Redis 强制 TLS 时设为 true
redis_use_ssl = false
# CA 证书路径，不校验服务端证书可留空
redis_ssl_cacert =

# ========== MySQL ==========
mysql_host = <MySQL地址>
mysql_port = 3306
mysql_username = <MySQL账号>
mysql_password = <MySQL密码>
mysql_dbname = <数据库名>

mysql_min_connection = 3
mysql_max_connection = 10
mysql_min_alive_minutes = 60
mysql_max_alive_minutes = 240
mysql_min_free_minutes = 20
mysql_max_free_minutes = 40

# ========== MinIO / 对象存储 ==========
# 服务端访问存储用的内网地址
# 自建 MinIO 示例：http://127.0.0.1:9000
# 云 OSS 示例：https://cos.ap-shanghai.myqcloud.com
minio_endpoint = <对象存储内网地址>

minio_access_key = <AccessKey>
minio_secret_key = <SecretKey>
minio_region = us-east-1
minio_bucket = chat

# ========== Public Access ==========
# 客户端下载地址前缀，必须以 / 结尾
# 自建 MinIO：https://<网关域名>/chat/
# 云 OSS：https://<OSS或CDN域名>/chat/
public_url_prefix = https://<域名>/chat/

# 大文件直传的目标域名，必须与预签名 URL 实际访问域名一致
# 自建 MinIO 填网关域名；云 OSS 填 bucket 或 CDN 域名
upload_public_host = <域名>

# ========== Timeouts ==========
mysql_connect_timeout = 3
# 单位 ms；Redis 走 TLS 或跨地域时建议调至 3000~5000
redis_connect_timeout = 1000
redis_socket_timeout = 1000
http_connect_timeout = 2
http_total_timeout = 5
